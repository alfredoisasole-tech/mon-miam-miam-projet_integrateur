{
  "info": {
    "_postman_id": "c0bdb42d-9382-4c93-b4dd-4b297a9566a8",
    "name": "Mon Miam Miam — API",
    "description": "Requêtes de vérification de l’API publique, des comptes, des commandes, du menu du personnel et de l’administration de plateforme. Renseigner les variables de compte avant les requêtes protégées.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api" },
    { "key": "restaurantSlug", "value": "zeduc-space" },
    { "key": "studentEmail", "value": "etudiant@monmiam.test" },
    { "key": "studentPassword", "value": "" },
    { "key": "staffEmail", "value": "employe@monmiam.test" },
    { "key": "staffPassword", "value": "" },
    { "key": "adminEmail", "value": "admin@zeduc-space.test" },
    { "key": "adminPassword", "value": "" },
    { "key": "platformAdminEmail", "value": "plateforme@monmiam.test" },
    { "key": "platformAdminPassword", "value": "" },
    { "key": "studentToken", "value": "" },
    { "key": "staffToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "platformAdminToken", "value": "" },
    { "key": "menuItemId", "value": "" },
    { "key": "orderId", "value": "" },
    { "key": "newRestaurantSlug", "value": "restaurant-demo" }
  ],
  "item": [
    {
      "name": "Public",
      "item": [
        {
          "name": "Health",
          "request": { "method": "GET", "url": "{{baseUrl}}/health" }
        },
        {
          "name": "Liste des restaurants",
          "request": { "method": "GET", "url": "{{baseUrl}}/restaurants?page=1&pageSize=20" }
        },
        {
          "name": "Profil du restaurant",
          "request": { "method": "GET", "url": "{{baseUrl}}/restaurants/{{restaurantSlug}}" }
        },
        {
          "name": "Menu public",
          "request": { "method": "GET", "url": "{{baseUrl}}/restaurants/{{restaurantSlug}}/menu" }
        },
        {
          "name": "Promotions actives",
          "request": { "method": "GET", "url": "{{baseUrl}}/restaurants/{{restaurantSlug}}/promotions" }
        }
      ]
    },
    {
      "name": "Comptes",
      "item": [
        {
          "name": "Inscrire un étudiant",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) pm.collectionVariables.set('studentToken', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Mbuyi\",\n  \"email\": \"{{studentEmail}}\",\n  \"phone\": \"+243815554433\",\n  \"password\": \"{{studentPassword}}\",\n  \"confirmPassword\": \"{{studentPassword}}\",\n  \"acceptTerms\": true\n}"
            },
            "url": "{{baseUrl}}/restaurants/{{restaurantSlug}}/auth/register"
          }
        },
        {
          "name": "Connexion étudiant",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) pm.collectionVariables.set('studentToken', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"{{studentEmail}}\",\n  \"password\": \"{{studentPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Profil courant",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": "{{baseUrl}}/me"
          }
        }
      ]
    },
    {
      "name": "Commandes étudiant",
      "item": [
        {
          "name": "Créer une commande sur place",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) pm.collectionVariables.set('orderId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{studentToken}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"restaurant\": \"{{restaurantSlug}}\",\n  \"type\": \"dine_in\",\n  \"paymentMethod\": \"cash\",\n  \"items\": [{ \"menuItemId\": \"{{menuItemId}}\", \"quantity\": 1 }],\n  \"redeemMeal\": false\n}"
            },
            "url": "{{baseUrl}}/orders"
          }
        },
        {
          "name": "Lister mes commandes",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": "{{baseUrl}}/orders?page=1&pageSize=20"
          }
        },
        {
          "name": "Détail de commande",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": "{{baseUrl}}/orders/{{orderId}}"
          }
        }
      ]
    },
    {
      "name": "Personnel et menu",
      "item": [
        {
          "name": "Connexion personnel",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) pm.collectionVariables.set('staffToken', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"{{staffEmail}}\",\n  \"password\": \"{{staffPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Lister le menu du restaurant",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{staffToken}}" }],
            "url": "{{baseUrl}}/staff/menu"
          }
        },
        {
          "name": "Modifier disponibilité d’un plat",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{staffToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"isAvailable\": false\n}" },
            "url": "{{baseUrl}}/staff/menu/{{menuItemId}}"
          }
        },
        {
          "name": "Lister les commandes du restaurant",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{staffToken}}" }],
            "url": "{{baseUrl}}/staff/orders"
          }
        },
        {
          "name": "Mettre à jour le statut d’une commande",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{staffToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"confirmed\"\n}" },
            "url": "{{baseUrl}}/staff/orders/{{orderId}}/status"
          }
        }
      ]
    },
    {
      "name": "Administration",
      "item": [
        {
          "name": "Connexion administrateur restaurant",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) pm.collectionVariables.set('adminToken', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Créer un plat",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) pm.collectionVariables.set('menuItemId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jus frais\",\n  \"description\": \"Jus du jour\",\n  \"priceFc\": 1500,\n  \"category\": \"boisson\",\n  \"isDaily\": false,\n  \"isAvailable\": true\n}"
            },
            "url": "{{baseUrl}}/admin/menu"
          }
        },
        {
          "name": "Connexion administrateur plateforme",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) pm.collectionVariables.set('platformAdminToken', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"{{platformAdminEmail}}\",\n  \"password\": \"{{platformAdminPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Créer un restaurant et son premier admin",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{platformAdminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slug\": \"{{newRestaurantSlug}}\",\n  \"name\": \"Restaurant de démonstration\",\n  \"admin\": {\n    \"name\": \"Admin local\",\n    \"email\": \"admin-local@example.test\",\n    \"phone\": \"+243820000010\",\n    \"password\": \"LocalAdmin1\"\n  }\n}"
            },
            "url": "{{baseUrl}}/platform/restaurants"
          }
        },
        {
          "name": "Activer ou désactiver un restaurant",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{platformAdminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"inactive\"\n}" },
            "url": "{{baseUrl}}/platform/restaurants/{{newRestaurantSlug}}/status"
          }
        }
      ]
    }
  ]
}
