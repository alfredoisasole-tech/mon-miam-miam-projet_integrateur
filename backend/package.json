{
  "name": "mon-miam-miam-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API de Mon Miam Miam (Node.js, Express, TypeScript).",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.ts",
    "dev": "node --env-file-if-exists=.env --watch src/main.ts",
    "seed": "node --env-file-if-exists=.env src/scripts/seed.ts",
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
