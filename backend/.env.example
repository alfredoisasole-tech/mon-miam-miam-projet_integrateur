# Modèle des variables d'environnement. Copiez ce fichier en .env puis adaptez-le : le fichier .env n'est JAMAIS publié.
NODE_ENV=development
PORT=3000
DATABASE_PATH=./data/mon-miam-miam.sqlite
# En production, mettez une longue valeur aléatoire (32 caractères minimum), jamais celle-ci.
JWT_SECRET=changez-moi-avec-une-longue-valeur-aleatoire-de-32-caracteres-minimum
PAYMENT_WEBHOOK_SECRET=cle-non-secrete-a-remplacer-par-une-valeur-aleatoire-en-production
# Adresses du site autorisées à appeler l'API, séparées par des virgules.
CORS_ORIGINS=http://localhost:5173
# Définir ces mots de passe uniquement pour le seed initial ; ne pas les publier.
SEED_RESTAURANT_ADMIN_PASSWORD=
SEED_EMPLOYEE_PASSWORD=
SEED_STUDENT_PASSWORD=
SEED_PLATFORM_ADMIN_PASSWORD=
# Fournisseur de paiement : « simulation » (défaut) ou « easypay » (passerelle e-COM EasyPay).
# Avec easypay, EASYPAY_CID, EASYPAY_TOKEN, EASYPAY_IPN_KEY et SITE_URL sont obligatoires. Ne publiez jamais leurs valeurs.
PAYMENT_PROVIDER=simulation
# « sandbox » (essais, défaut) ou « v1 » (production).
EASYPAY_MODE=sandbox
# Identifiants de l'espace développeur Easypay (menu « Espace Développeur » de l'espace marchand).
EASYPAY_CID=
EASYPAY_TOKEN=
# Clé secrète ajoutée à l'adresse de notification déclarée chez Easypay (32 caractères minimum, valeur aléatoire).
EASYPAY_IPN_KEY=
# Adresse publique du site, sans « / » final : base des adresses de retour après paiement. Exemple : https://mon-site.vercel.app
SITE_URL=
