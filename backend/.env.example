# Modèle des variables d'environnement. Copiez ce fichier en .env puis adaptez-le : le fichier .env n'est JAMAIS publié.
NODE_ENV=development
PORT=3000
DATABASE_PATH=./data/mon-miam-miam.sqlite
# En production, mettez une longue valeur aléatoire (32 caractères minimum), jamais celle-ci.
JWT_SECRET=changez-moi-avec-une-longue-valeur-aleatoire-de-32-caracteres-minimum
PAYMENT_WEBHOOK_SECRET=cle-non-secrete-a-remplacer-par-une-valeur-aleatoire-en-production
# Adresses du site autorisées à appeler l'API, séparées par des virgules.
CORS_ORIGINS=http://localhost:5173
